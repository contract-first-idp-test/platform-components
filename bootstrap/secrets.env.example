# Workshop demo identity.
DEMO_USER_USERNAME=platform-user
DEMO_USER_PASSWORD=

# Developer Hub and Dev Spaces use these values from one CF-IDP GitHub App. Copy its App ID, Client ID,
# and generated Client Secret; encode its downloaded private-key PEM with `base64 -w 0`.
# See the authoritative setup procedure in bootstrap/README.md.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Generate blank component secrets before installation, for example with:
#   openssl rand -base64 32

# Developer Hub
BACKSTAGE_BACKEND_SECRET=
KEYCLOAK_BACKSTAGE_CLIENT_SECRET=

# Microcks
KEYCLOAK_MICROCKS_CLIENT_SECRET=
MICROCKS_MONGODB_USERNAME=microcks
MICROCKS_MONGODB_PASSWORD=
MICROCKS_MONGODB_ADMIN_USERNAME=admin
MICROCKS_MONGODB_ADMIN_PASSWORD=

# Quay
QUAY_ADMIN_USERNAME=quayadmin
QUAY_ADMIN_EMAIL=quayadmin@example.com
QUAY_ADMIN_PASSWORD=

# Gitea (optional)
GITEA_ADMIN_USERNAME=giteaadmin
GITEA_ADMIN_EMAIL=giteaadmin@example.com
GITEA_ADMIN_PASSWORD=
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=
GITEA_JWT_SECRET=
