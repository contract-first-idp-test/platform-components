# Required GitHub token. Fine-grained token permissions depend on the companion
# templates, but the demo needs repository creation, content, and pull-request
# administration in the target organization.
GITHUB_TOKEN=

# GitHub OAuth application used by Dev Spaces.
DEVSPACES_GITHUB_CLIENT_ID=
DEVSPACES_GITHUB_CLIENT_SECRET=

# Generate these before installation. Example:
#   openssl rand -base64 32
BACKEND_SECRET=
KEYCLOAK_BACKSTAGE_CLIENT_SECRET=
KEYCLOAK_MICROCKS_CLIENT_SECRET=
DEMO_USER_PASSWORD=
QUAY_ADMIN_PASSWORD=
MICROCKS_MONGODB_USERNAME=microcks
MICROCKS_MONGODB_PASSWORD=
MICROCKS_MONGODB_ADMIN_USERNAME=admin
MICROCKS_MONGODB_ADMIN_PASSWORD=

# Human-selected bootstrap identity.
QUAY_ADMIN_USERNAME=quayadmin
QUAY_ADMIN_EMAIL=quayadmin@example.com

# Reserved for the optional Gitea overlay.
GITEA_ADMIN_USERNAME=giteaadmin
GITEA_ADMIN_EMAIL=giteaadmin@example.com
GITEA_ADMIN_PASSWORD=
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=
GITEA_JWT_SECRET=
