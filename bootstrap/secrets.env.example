# Workshop demo identity.
DEMO_USER_USERNAME=platform-user
DEMO_USER_PASSWORD=

# Developer Hub and Dev Spaces use these values from one CF-IDP GitHub App. Copy its App ID, Client ID,
# and generated Client Secret; encode its downloaded private-key PEM with `base64 -w 0`.
# See the authoritative setup procedure in docs/installation.md.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Other platform-owned passwords and tokens are generated by External Secrets Operator.

# Quay
QUAY_ADMIN_USERNAME=quayadmin
QUAY_ADMIN_EMAIL=quayadmin@example.com

# Gitea (optional)
GITEA_ADMIN_USERNAME=giteaadmin
GITEA_ADMIN_EMAIL=giteaadmin@example.com
