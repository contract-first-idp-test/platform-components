# Mutable configuration fork watched by this installed platform instance.
PLATFORM_REPO_URL=https://github.com/contract-first-idp/platform-components.git
PLATFORM_CONFIG_REVISION=main

# SCM and cluster primitives required by bootstrap consumers.
GITHUB_HOST=github.com
GITHUB_API_URL=https://api.github.com
GITHUB_ORG=contract-first-idp
CLUSTER_NAME=development-cluster
CLUSTER_API_URL=https://api.example.cluster.com:6443

# Immutable coordinated dependencies and their catalog paths.
SOFTWARE_TEMPLATES_REPO_URL=https://github.com/contract-first-idp/software-templates.git
SOFTWARE_TEMPLATES_REVISION=v1.0.0
SOFTWARE_TEMPLATES_CATALOG_PATH=catalog-info.yaml
DEVELOPER_CHARTS_REPO_URL=https://github.com/contract-first-idp/developer-charts.git
DEVELOPER_CHARTS_REVISION=v1.0.0
PLATFORM_TARGET_NAME=workshop
PLATFORM_TARGET_CATALOG_PATH=targets/workshop/catalog-info.yaml
SPECTRAL_RULES_REPO_URL=https://github.com/contract-first-idp/spectral-rules.git

# Public identity primitives used before target configuration is parsed.
KEYCLOAK_REALM=cf-idp
KEYCLOAK_CLIENT_ID=backstage

# Direct scalar exceptions: these CR fields cannot consume Secrets and cannot be omitted.
# Their authoritative counterparts are validated against targets/workshop/catalog-info.yaml.
QUAY_INTEGRATION_URL=https://registry-quay-quay.apps.example.cluster.com
APICURIO_APP_HOST=apicurio.apps.example.cluster.com
APICURIO_UI_HOST=apicurio-ui.apps.example.cluster.com
